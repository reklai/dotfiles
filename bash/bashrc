#
# ~/.bashrc
#

# No interactive-only `return`. Ghostty runs `bash -l -c nu` (login,
# non-interactive); installers append `export PATH=...` at the end of this
# file, and those must run so Nushell inherits them. Aliases/functions still
# do not carry into nu.
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.opencode/bin:$PATH"
export JAVA_HOME=/usr/lib/jvm/java-21-openjdk
export PATH="$JAVA_HOME/bin:$PATH"
export PATH="$HOME/.grok/bin:$PATH"
export PATH="$HOME/.bun/bin:$PATH"

alias grep='grep --color=auto'

# >>> grok installer >>>
[[ -r "$HOME/.grok/completions/bash/grok.bash" ]] && source "$HOME/.grok/completions/bash/grok.bash"
# <<< grok installer <<<
